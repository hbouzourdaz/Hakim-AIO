@echo off
setlocal EnableExtensions EnableDelayedExpansion
title PC CARE AIO  ^|  HAKIM BOUZOURDAZ
mode con: cols=88 lines=32
color 0B

:: PC CARE AIO - CMD-only modern console UI with embedded MAS and Chris Titus utility
:: Developed by Hakim Bouzourdaz
:: No automatic personal-file deletion, registry edits, or service changes.

:: Enable ANSI colors on modern Windows Terminal / Windows 10+ CMD.
:: If ANSI is unsupported, the normal CMD color still keeps the menu readable.
for /F "delims=" %%E in ('echo prompt $E^| cmd') do set "ESC=%%E"
set "C_RESET=%ESC%[0m"
set "C_CYAN=%ESC%[96m"
set "C_BLUE=%ESC%[94m"
set "C_GREEN=%ESC%[92m"
set "C_YELLOW=%ESC%[93m"
set "C_PURPLE=%ESC%[95m"
set "C_RED=%ESC%[91m"
set "C_WHITE=%ESC%[97m"
set "C_GRAY=%ESC%[90m"

:HOME
cls
color 0B
echo.
echo  %C_CYAN%================================================================================%C_RESET%
echo  %C_WHITE%  HAKIM BOUZOURDAZ%C_RESET%  %C_GRAY%/ %C_RESET%%C_CYAN%PC CARE AIO%C_RESET%
echo  %C_GRAY%  WINDOWS MAINTENANCE CENTER%C_RESET%
echo  %C_CYAN%================================================================================%C_RESET%
echo.
echo  %C_BLUE%[01]%C_RESET% PC overview                  %C_BLUE%[05]%C_RESET% Network diagnostics
echo  %C_BLUE%[02]%C_RESET% System file check            %C_BLUE%[06]%C_RESET% Battery and power
echo  %C_BLUE%[03]%C_RESET% Windows repair               %C_BLUE%[07]%C_RESET% Security tools
echo  %C_BLUE%[04]%C_RESET% Drive scan                   %C_BLUE%[08]%C_RESET% Safe cleanup
echo.
echo  %C_GREEN%[09]%C_RESET% WIN/Office Activation Scripts (MAS)
echo  %C_PURPLE%[10]%C_RESET% Chris Titus Tech's Windows Utility
echo.
echo  %C_GRAY%--------------------------------------------------------------------------------%C_RESET%
echo  %C_GREEN%  SAFE BY DEFAULT%C_RESET% %C_GRAY%- No automatic deletion - No registry tweaks%C_RESET%
echo  %C_GRAY%--------------------------------------------------------------------------------%C_RESET%
echo.
echo   [0] Exit
echo.
set "pick="
set /p "pick=Select an option ^> "

if "%pick%"=="1" goto OVERVIEW
if "%pick%"=="01" goto OVERVIEW
if "%pick%"=="2" goto SFC
if "%pick%"=="02" goto SFC
if "%pick%"=="3" goto REPAIR
if "%pick%"=="03" goto REPAIR
if "%pick%"=="4" goto DISK
if "%pick%"=="04" goto DISK
if "%pick%"=="5" goto NETWORK
if "%pick%"=="05" goto NETWORK
if "%pick%"=="6" goto POWER
if "%pick%"=="06" goto POWER
if "%pick%"=="7" goto SECURITY
if "%pick%"=="07" goto SECURITY
if "%pick%"=="8" goto CLEAN
if "%pick%"=="08" goto CLEAN
if /i "%pick%"=="9" goto MASLAUNCH
if /i "%pick%"=="09" goto MASLAUNCH
if /i "%pick%"=="10" goto CHRISTITUS
if "%pick%"=="0" goto END
goto HOME

:OVERVIEW
cls
call :SUBHEAD "PC OVERVIEW"
echo  %C_BLUE%DEVICE%C_RESET%
echo  %C_GRAY%----------------------------------------------------------------------------------------%C_RESET%
powershell -NoProfile -Command "$cs=Get-CimInstance Win32_ComputerSystem; $os=Get-CimInstance Win32_OperatingSystem; $cpu=Get-CimInstance Win32_Processor | Select-Object -First 1; Write-Host ('  PC NAME       : '+$env:COMPUTERNAME); Write-Host ('  MANUFACTURER  : '+$cs.Manufacturer); Write-Host ('  MODEL         : '+$cs.Model); Write-Host ('  WINDOWS       : '+$os.Caption+' / '+$os.OSArchitecture); Write-Host ('  CPU           : '+$cpu.Name); Write-Host ('  LOGICAL CORES : '+$cpu.NumberOfLogicalProcessors); Write-Host ('  RAM TOTAL     : '+[math]::Round($cs.TotalPhysicalMemory/1GB,1)+' GB'); Write-Host ('  LAST BOOT     : '+$os.LastBootUpTime)"
echo.
echo  %C_GREEN%MEMORY%C_RESET%
echo  %C_GRAY%----------------------------------------------------------------------------------------%C_RESET%
powershell -NoProfile -Command "$o=Get-CimInstance Win32_OperatingSystem; $t=[math]::Round($o.TotalVisibleMemorySize/1MB,1); $f=[math]::Round($o.FreePhysicalMemory/1MB,1); Write-Host ('  TOTAL '+$t+' GB    AVAILABLE '+$f+' GB    USED (approx.) '+[math]::Round($t-$f,1)+' GB')"
echo.
echo  %C_PURPLE%DISKS & VOLUMES%C_RESET%
echo  %C_GRAY%----------------------------------------------------------------------------------------%C_RESET%
powershell -NoProfile -Command "Get-PhysicalDisk -ErrorAction SilentlyContinue | Select-Object FriendlyName,MediaType,HealthStatus,OperationalStatus,@{N='SizeGB';E={[math]::Round($_.Size/1GB,1)}} | Format-Table -AutoSize"
powershell -NoProfile -Command "Get-Volume -ErrorAction SilentlyContinue | Select-Object DriveLetter,HealthStatus,@{N='SizeGB';E={if($_.Size -gt 0){[math]::Round($_.Size/1GB,1)}else{0}}},@{N='FreeGB';E={if($_.SizeRemaining -ge 0){[math]::Round($_.SizeRemaining/1GB,1)}else{0}}} | Format-Table -AutoSize"
echo.
echo  %C_CYAN%NETWORK%C_RESET%
powershell -NoProfile -Command "Get-NetAdapter -ErrorAction SilentlyContinue | Select-Object Name,Status,LinkSpeed | Format-Table -AutoSize"
echo.
echo  %C_GRAY%Health values are reported by Windows and do not guarantee hardware condition.%C_RESET%
call :PAUSEBACK
goto HOME

:SFC
cls
call :SUBHEAD "SYSTEM FILE CHECK"
echo.
echo  Scans protected Windows files and attempts repairs if needed.
echo  %C_GRAY%Your personal documents are not targeted by SFC.%C_RESET%
echo.
call :CONFIRM "Run sfc /scannow"
if errorlevel 1 goto HOME
sfc /scannow
call :PAUSEBACK
goto HOME

:REPAIR
cls
call :SUBHEAD "WINDOWS REPAIR"
echo.
echo  %C_GREEN%[1]%C_RESET% DISM  - repair Windows component image
echo  %C_GREEN%[2]%C_RESET% SFC   - verify protected system files
echo  %C_GREEN%[3]%C_RESET% BOTH  - recommended order: DISM, then SFC
echo  %C_GRAY%[0] Back%C_RESET%
echo.
set "r="
set /p "r=  Select  > "
if "%r%"=="1" (
  call :CONFIRM "Run DISM RestoreHealth"
  if errorlevel 1 goto HOME
  DISM /Online /Cleanup-Image /RestoreHealth
  call :PAUSEBACK
  goto HOME
)
if "%r%"=="2" (
  call :CONFIRM "Run SFC scan"
  if errorlevel 1 goto HOME
  sfc /scannow
  call :PAUSEBACK
  goto HOME
)
if "%r%"=="3" (
  call :CONFIRM "Run DISM followed by SFC"
  if errorlevel 1 goto HOME
  DISM /Online /Cleanup-Image /RestoreHealth
  sfc /scannow
  call :PAUSEBACK
  goto HOME
)
goto HOME

:DISK
cls
call :SUBHEAD "DRIVE SCAN"
echo.
set "drv=C:"
set /p "drv=  Drive letter [default C:]: "
if not defined drv set "drv=C:"
set "drv=%drv:"=%"
if not "%drv:~1,1%"==":" set "drv=%drv%:"
if not "%drv:~2,1%"=="" (
  echo  %C_RED%Invalid drive. Example: C:%C_RESET%
  call :PAUSEBACK
  goto HOME
)
echo.
echo  Command: chkdsk %drv% /scan
echo  %C_GRAY%Online scan; no forced /f or /r repair.%C_RESET%
call :CONFIRM "Scan drive %drv%"
if errorlevel 1 goto HOME
chkdsk %drv% /scan
call :PAUSEBACK
goto HOME

:NETWORK
cls
call :SUBHEAD "NETWORK DIAGNOSTICS"
echo.
echo  %C_BLUE%[1] IP CONFIGURATION%C_RESET%
ipconfig /all
echo.
echo  %C_BLUE%[2] CONNECTIVITY TEST%C_RESET%
ping -n 4 8.8.8.8
echo.
echo  %C_BLUE%[3] DNS LOOKUP%C_RESET%
nslookup google.com
echo.
call :CONFIRM "Clear temporary DNS cache"
if not errorlevel 1 ipconfig /flushdns
call :PAUSEBACK
goto HOME

:POWER
cls
call :SUBHEAD "BATTERY & POWER"
echo.
echo  %C_GREEN%[1]%C_RESET% Create battery report
echo  %C_GREEN%[2]%C_RESET% Show last wake reason
echo  %C_GREEN%[3]%C_RESET% Show active power requests
echo  %C_GRAY%[0] Back%C_RESET%
echo.
set "b="
set /p "b=  Select  > "
if "%b%"=="1" (
  powercfg /batteryreport /output "%USERPROFILE%\battery-report.html"
  echo  Saved: "%USERPROFILE%\battery-report.html"
  call :PAUSEBACK
  goto HOME
)
if "%b%"=="2" (powercfg /lastwake & call :PAUSEBACK & goto HOME)
if "%b%"=="3" (powercfg /requests & call :PAUSEBACK & goto HOME)
goto HOME

:SECURITY
cls
call :SUBHEAD "SECURITY TOOLS"
echo.
echo  %C_GREEN%[1]%C_RESET% Open Windows Security
echo  %C_GREEN%[2]%C_RESET% Run Microsoft Malicious Software Removal Tool (MRT)
echo  %C_GRAY%[0] Back%C_RESET%
echo.
set "s="
set /p "s=  Select  > "
if "%s%"=="1" start "" windowsdefender:
if "%s%"=="2" start "" mrt.exe
if "%s%"=="0" goto HOME
call :PAUSEBACK
goto SECURITY

:CLEAN
cls
call :SUBHEAD "SAFE CLEANUP"
echo.
echo  %C_YELLOW%[1]%C_RESET% Open Windows Disk Cleanup
echo  %C_YELLOW%[2]%C_RESET% Open TEMP folder for manual review
echo  %C_GRAY%[0] Back%C_RESET%
echo.
set "c="
set /p "c=  Select  > "
if "%c%"=="1" start "" cleanmgr.exe
if "%c%"=="2" start "" "%TEMP%"
if "%c%"=="0" goto HOME
echo.
echo  %C_YELLOW%No files are deleted automatically. Review items manually.%C_RESET%
call :PAUSEBACK
goto CLEAN

:: Launch Chris Titus Tech Windows Utility after explicit confirmation.
:CHRISTITUS
cls
call :SUBHEAD "CHRIS TITUS WINDOWS UTILITY"
echo.
echo  %C_YELLOW%This downloads and runs a script from christitus.com.%C_RESET%
echo  %C_YELLOW%Review the source first; it can make system-level changes.%C_RESET%
echo  %C_GRAY%Only continue if you trust the source and understand the changes.%C_RESET%
echo.
call :CONFIRM "Download and run Chris Titus Windows Utility"
if errorlevel 1 goto HOME
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "irm https://christitus.com/win | iex"
echo.
echo  %C_GRAY%The utility has exited or returned control to PC Care.%C_RESET%
call :PAUSEBACK
goto HOME

:: Open embedded MAS AIO after explicit confirmation.
:MASLAUNCH
cls
call :SUBHEAD "MAS AIO - EMBEDDED"
echo.
echo  %C_YELLOW%MAS AIO is embedded in this single file.%C_RESET%
echo  %C_GRAY%It will be extracted to TEMP only while running.%C_RESET%
echo  Review the script source and use activation tools only with valid licenses.
echo.
call :CONFIRM "Extract and launch embedded MAS AIO"
if errorlevel 1 goto HOME
set "MAS_TEMP=%TEMP%\Hakim_PC_Care_MAS_%RANDOM%%RANDOM%.cmd"
set "MAS_SOURCE=%~f0"
set "MAS_OUTPUT=%MAS_TEMP%"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$p=$env:MAS_SOURCE; $o=$env:MAS_OUTPUT; $raw=[IO.File]::ReadAllText($p); $marker=('::###MAS_AIO_'+'PAYLOAD_START###'); $i=$raw.IndexOf($marker); if($i -lt 0){throw 'Embedded payload marker not found'}; $b=($raw.Substring($i+$marker.Length) -replace '\s',''); [IO.File]::WriteAllBytes($o,[Convert]::FromBase64String($b))"
if errorlevel 1 (
  echo.
  echo  %C_RED%Could not extract the embedded MAS payload.%C_RESET%
  call :PAUSEBACK
  goto HOME
)
echo.
echo  %C_GREEN%Launching embedded MAS AIO...%C_RESET%
start /wait "" "%MAS_TEMP%"
del /q "%MAS_TEMP%" >nul 2>&1
set "MAS_TEMP="
call :PAUSEBACK
goto HOME

:SUBHEAD
cls
echo.
echo  %C_CYAN%+==================================================================================+%C_RESET%
echo  %C_CYAN%^|%C_RESET%  %C_WHITE%HAKIM BOUZOURDAZ%C_RESET%  %C_GRAY%^|%C_RESET%  %C_CYAN%PC CARE%C_RESET%                                                   %C_CYAN%^|%C_RESET%
echo  %C_CYAN%+----------------------------------------------------------------------------------+%C_RESET%
echo  %C_YELLOW%  %~1%C_RESET%
echo  %C_CYAN%+==================================================================================+%C_RESET%
echo.
exit /b

:CONFIRM
echo.
choice /C YN /N /M "  %~1? [Y/N] "
if errorlevel 2 exit /b 1
exit /b 0

:PAUSEBACK
echo.
echo  %C_GRAY%----------------------------------------------------------------------------------------%C_RESET%
pause
exit /b

:END
cls
echo.
echo  %C_CYAN%+==================================================================================+%C_RESET%
echo  %C_WHITE%                         HAKIM BOUZOURDAZ%C_RESET%
echo  %C_GREEN%                     THANK YOU FOR USING PC CARE%C_RESET%
echo  %C_CYAN%+==================================================================================+%C_RESET%
echo.
endlocal
exit /b

